# PostgreSQL connection string (Supabase, Neon, RDS, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/pricewatch"

# 32+ char random string used to sign session JWTs. Generate: openssl rand -hex 32
SESSION_SECRET=""

# Resend API key (https://resend.com). Leave empty in dev — emails are logged to the console instead.
RESEND_API_KEY=""

# Verified sender for outgoing email
EMAIL_FROM="Travel Price Watch <alerts@yourdomain.com>"

# Public base URL of the app (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret protecting the /api/cron/check-prices endpoint.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
